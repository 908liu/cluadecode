# === 必填 ===
# 生成方式：openssl rand -hex 32
APP_SECRET=replace-with-a-random-secret
# 公网域名（A 记录指向服务器）；本地纯 HTTP 测试用 :80
DOMAIN=kb.example.com

# === 注册控制 ===
# open | first-user | invite | closed
# 公网推荐 first-user（首个账号创建后自动关闭注册）
REGISTRATION_MODE=first-user
# Maximum number of non-admin accounts that can register
MAX_NORMAL_USERS=10
# Registration requests per IP per window; raise temporarily for load testing
REGISTER_RATE_LIMIT=20
REGISTER_RATE_WINDOW=60
# REGISTRATION_MODE=invite 时必填
REGISTRATION_INVITE_CODE=

# === 上游模型服务安全 ===
# 1 = 拒绝指向本机/内网/云元数据地址的 base_url（生产必须为 1）
BLOCK_PRIVATE_UPSTREAM=1
# 可选：只允许这些域名及其子域，逗号分隔；留空表示允许任意公网域名。
# 白名单内的主机被视为受信任（可用于明确放行自建内网模型服务）。
# 例：dashscope.aliyuncs.com,api.anthropic.com
MODEL_HOST_ALLOWLIST=

# === 数据目录 ===
# 容器内固定为 /app/data；这里填宿主机路径
# Linux 服务器请先 mkdir 并 chown 10001:10001
DATA_DIR_HOST=./data

# app 容器内存上限；2C2G 服务器保持 1536m 并配置 swap
APP_MEM_LIMIT=1536m

# === 可选：环境变量模型服务（所有注册用户共享，公网慎用） ===
# CHAT_BASE_URL=
# CHAT_API_KEY=
# CHAT_MODEL=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
# EMBEDDING_DIM=
# RERANK_BASE_URL=
# RERANK_API_KEY=
# RERANK_MODEL=

# === 可选：限流参数（默认值即可） ===
# UPLOAD_RATE_LIMIT=10
# UPLOAD_RATE_WINDOW=60
# EVAL_RATE_LIMIT=3
# EVAL_RATE_WINDOW=60