APP_ENV=dev
DATA_DIR=./data
# 生产环境必须设置为非空的随机长字符串（openssl rand -hex 32）
# APP_SECRET=change-me
# 注册控制：open | first-user | invite | closed
REGISTRATION_MODE=open
# Maximum number of non-admin accounts that can register
MAX_NORMAL_USERS=10
# Registration requests per IP per window; raise temporarily for load testing
REGISTER_RATE_LIMIT=20
REGISTER_RATE_WINDOW=60
# REGISTRATION_MODE=invite 时必填
# REGISTRATION_INVITE_CODE=
# 1 = 拒绝指向本机/内网/云元数据地址的模型服务 base_url
BLOCK_PRIVATE_UPSTREAM=0
# 可选：模型服务域名白名单，逗号分隔
# MODEL_HOST_ALLOWLIST=dashscope.aliyuncs.com
UPLOAD_RATE_LIMIT=10
UPLOAD_RATE_WINDOW=60
EVAL_RATE_LIMIT=3
EVAL_RATE_WINDOW=60
# 可选：显式指定数据库与加密密钥路径
# DATABASE_PATH=./data/app.db
# CHROMA_DIR=./data/chroma
# ENCRYPTION_KEY_PATH=./data/.encryption_key
TOKEN_TTL_SECONDS=86400
UPLOAD_MAX_BYTES=52428800
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_CANDIDATES=20
# 部分 Embedding 服务单次请求条数有限（如阿里 text-embedding-v3 常见为 10），按服务商调整
EMBEDDING_BATCH_SIZE=32
SCORE_THRESHOLD=0.6
RRF_K=60
TOP_K=4
# Rerank（可选）：用户级默认关闭；设为 0 可全局禁用重排调用
RERANK_ENABLED=1
RERANK_TOP_N=20
# 0 表示不按重排分过滤，只按 top_k 截断
RERANK_MIN_SCORE=0.0
RERANK_TIMEOUT_CAP=5
# 环境变量 rerank 服务默认协议：cohere | dashscope
RERANK_PROTOCOL=cohere

TRASH_RETENTION_DAYS=7
QA_RECORD_RETENTION_DAYS=30
DOCX_MAX_UNCOMPRESSED_BYTES=209715200
PDF_MAX_PAGES=1000
DOC_MAX_CHARS=5000000
TRUST_PROXY_HEADERS=0
INDEX_CACHE_MAX_USERS=8
# CORS_ORIGINS=http://localhost:5173

# 环境变量模型服务（只读展示，DB 默认服务优先）
# CHAT_BASE_URL=
# CHAT_API_KEY=
# CHAT_MODEL=
# CHAT_TIMEOUT=20
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
# EMBEDDING_DIM=
# EMBEDDING_TIMEOUT=30
# RERANK_BASE_URL=
# RERANK_API_KEY=
# RERANK_MODEL=
# RERANK_TIMEOUT=20